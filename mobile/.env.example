# AURA Mobile Configuration

# Set to false to use the live GPT-backed chat flow instead of local deterministic mocks
EXPO_PUBLIC_USE_MOCK_AI=false

# When true, uses virtual wearable with simulated button presses and battery
EXPO_PUBLIC_USE_MOCK_BLE=false

# Backend REST API endpoint (use your machine's LAN IP for physical Android testing, or 10.0.2.2 for Android emulator)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000

# Real-time voice WebSocket endpoint
EXPO_PUBLIC_WEBSOCKET_URL=ws://10.0.2.2:4000/ws/voice
