# AURA Backend Configuration

PORT=4000
NODE_ENV=development

# When true, backend uses deterministic academic mock AI responses without calling external APIs
USE_MOCK_AI=false

# Database Connection (PostgreSQL)
# In development, the backend automatically uses an in-memory repository fallback if PostgreSQL is offline
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aura_db

# Redis Cache / PubSub (Optional)
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=aura-super-secret-production-jwt-key-32chars

# AI Providers (Only needed when USE_MOCK_AI=false)

OPENAI_MODEL=gpt-4o-mini
CLAUDE_API_KEY=your_anthropic_claude_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
